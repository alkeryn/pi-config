{
  "comment": "Copy the pieces you want into ~/.pi/agent/keybindings.json. The \"modal\" block is read by the modal_keybinds extension; pi itself ignores it. Entries in the modal block are deep-merged over the extension's built-in defaults, so you only need to list what you want to change.",

  "app.message.copy": ["ctrl+shift+x"],

  "modal": {
    "timeoutMs": 7000,

    "bindings": {
      "ctrl+x": {
        "l": { "type": "model", "label": "Switch model" },
        "c": { "type": "compact", "label": "Compact conversation" },
        "f": { "type": "message", "text": "Fix the latest errors in the code.", "label": "Fix errors" },
        "s": { "type": "message", "text": "Summarize what changed in this session.", "label": "Summarize session" },
        "e": { "type": "editorAppend", "text": "\n> ", "label": "Quote line" },
        "n": { "type": "notify", "message": "hello from ctrl+x n", "label": "Test notification" },
        "d": { "type": "handler", "name": "toggleDemoWidget", "label": "Toggle demo widget" },
        "g": {
          "b": { "type": "notify", "message": "ctrl+x g b", "label": "agb" },
          "r": { "type": "notify", "message": "ctrl+x g r", "label": "agr" }
        }
      },

      "alt+x": {
        "n": { "type": "notify", "message": "alt+x n works too", "label": "Notify" },
        "t": { "type": "editor", "text": "/tree", "label": "Pre-fill /tree" }
      }
    }
  }
}
